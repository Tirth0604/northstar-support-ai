APP_ENV=development
APP_NAME=Northstar Support AI
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/support_ai
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CONFIRMATION_EXPIRE_MINUTES=10
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store
UPLOAD_DIRECTORY=./data/uploads
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.18
MAX_AGENT_STEPS=6
MAX_TOOL_FAILURES=2
ESCALATION_TURN_THRESHOLD=8
MAX_UPLOAD_SIZE_MB=20
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000/api/v1
